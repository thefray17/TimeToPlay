
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/avatar {
      // Allow read access to everyone for profile pictures
      allow read: if true;
      
      // Allow write access only to the authenticated user for their own avatar
      // - userId in the path must match the authenticated user's uid
      // - The uploaded file size must be less than 5MB
      // - The content type must be an image
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
