/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model for all private user information, including profiles and bookings.
 * All user-specific data is segregated into a private data tree, accessible only to the authenticated owner. Publicly searchable
 * data, such as sports courts, is stored in a separate top-level collection that is world-readable but not client-writable,
 * ensuring data integrity.
 *
 * Data Structure:
 * - /users/{userId}: Contains private user profile data and subcollections.
 * - /users/{userId}/{path=**}: Recursively matches all subcollections and documents under a user's private data tree.
 * - /courts/{courtId}: A top-level collection containing public information about sports courts.
 *
 * Key Security Decisions:
 * - User Enumeration is Disabled: Listing documents in the top-level `/users` collection is explicitly forbidden to protect user privacy.
 * - Public Data is Read-Only: The `/courts` collection and its subcollections are publicly readable to allow for searching and browsing, but all client-side writes are disabled.
 * - Strict, Recursive Ownership: All operations within a user's data tree (`/users/{userId}/{path=**}`) are strictly limited to that authenticated user using a recursive wildcard match.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is the owner of the document.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for the public collection of sports courts and their subcollections.
    // This data is readable by anyone. Client-side writes are mostly disabled,
    // except for updating the availability subcollection.
    match /courts/{courtId} {
      allow read: if true;
      allow write: if false; // Protect court data from client-side modification.
    }

    match /courts/{courtId}/availability/{dateKey} {
      allow read: if true;
      // Allow authenticated users to create/update availability when they book.
      allow write: if request.auth != null;
    }

    // Secure all user-related data with recursive ownership rules.
    match /users/{userId}/{path=**} {
      // A user can perform any action on any document within their own data tree.
      allow read, write: if isOwner(userId);
    }
  }
}
