rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if a user is authenticated and is the owner of a document.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for the `courts` collection.
    // Courts are public to read, but only the owner can modify them.
    match /courts/{courtId} {
      // Anyone, authenticated or not, can read court data.
      allow read: if true;
      
      // A user can create a court if the `ownerId` in the new document matches their UID.
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;

      // Only the existing court owner can update it.
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // No one can delete courts directly for data integrity.
      allow delete: if false;

      // Rules for the `availability` subcollection of a court.
      // This allows checking for open slots.
      match /availability/{dateKey} {
        allow read: if true;
        // Authenticated users can write to availability when creating a booking.
        allow write: if request.auth != null;
      }
    }

    // Rules for the `users` collection and its subcollections.
    match /users/{userId} {
      // A user can only read and write their own top-level profile document.
      allow read, write: if isOwner(userId);

      // Rules for a user's `bookings` subcollection (for players).
      match /bookings/{bookingId} {
        // A user can create, read, and write (e.g., cancel) their own bookings.
        allow read, write, create: if isOwner(userId);
      }

      // Rules for a user's `owner_bookings` subcollection (for court owners).
      match /owner_bookings/{bookingId} {
         // A court owner can read and write (e.g., accept/decline) bookings for their courts.
        allow read, write: if isOwner(userId);
      }

      // Rules for a user's `favorites` subcollection.
      match /favorites/{favoriteId} {
        // A user can manage their own list of favorite courts.
        allow read, write, create, delete: if isOwner(userId);
      }
    }
  }
}
