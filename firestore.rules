rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if user is the document owner.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper to check if a user has the 'owner' role.
    function isCourtOwner(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.role == 'owner';
    }

    // Rules for the public `courts` collection.
    match /courts/{courtId} {
      // Anyone can read court data.
      allow read: if true;
      
      // Only the user specified in `ownerId` can create or update a court.
      // The user creating the court must have the 'owner' role.
      allow create: if request.resource.data.ownerId == request.auth.uid &&
                       isCourtOwner(request.auth.uid);

      // Only the existing court owner can update it. No one can delete courts directly.
      allow update: if resource.data.ownerId == request.auth.uid;
      allow delete: if false;

      // Rules for the `availability` subcollection.
      match /availability/{dateKey} {
        allow read: if true;
        // Authenticated users can write to availability when creating a booking.
        // Court owners can also manage availability.
        allow write: if request.auth != null;
      }
    }
    
    // Rules for the global `bookings` collection.
    match /bookings/{bookingId} {
      // A user can create a booking for themselves.
      allow create: if request.auth.uid == request.resource.data.userId;

      // Read is allowed if the user is the player who booked it OR the owner of the court.
      allow read: if request.auth.uid == resource.data.userId || 
                     isCourtOwner(request.auth.uid) && resource.data.ownerId == request.auth.uid;
                     
      // Updates are allowed by the player (to cancel) or the owner (to change status).
      allow update: if (request.auth.uid == resource.data.userId && request.resource.data.status == 'cancelled') ||
                       (isCourtOwner(request.auth.uid) && resource.data.ownerId == request.auth.uid);

      // No one can delete booking records directly. Status should be updated to 'cancelled'.
      allow delete: if false;
    }

    // Secure all user-related data with recursive ownership rules.
    // This allows a user to perform any action on any document within their own data tree.
    // This covers /users/{userId}, /users/{userId}/favorites/{favId}, etc.
    match /users/{userId}/{path=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
