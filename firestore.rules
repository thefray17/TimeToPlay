
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //-------------------------------------------------------------------------
    // Helper Functions
    //-------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    //-------------------------------------------------------------------------
    // Collection Rules
    //-------------------------------------------------------------------------

    // 1. Courts are public
    match /courts/{courtId} {
      allow read: if true;
      allow write: if false; // Managed by admin script

      match /availability/{dateKey} {
        allow read: if true;
        allow write: if false;
      }
    }

    // 2. Users can only manage their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 3. Favorites are private to the owner
    match /users/{userId}/favorites/{courtId} {
        allow read, write: if isOwner(userId);
    }
    
    // 4. Bookings are private to the owner
    // =====================================================================
    // TEMPORARY DIAGNOSTIC RULE:
    // This rule is intentionally insecure for debugging. It allows ANYONE
    // to read bookings. If your app works with this rule, it proves the
    // problem is in the security logic (isOwner check). If it STILL fails,
    - // the problem is in your app's query path or project configuration.
    //
    // AFTER TESTING, YOU MUST REPLACE THIS WITH THE SECURE RULE BELOW.
    // =====================================================================
    match /users/{userId}/bookings/{bookingId} {
      // --- START TEMPORARY RULE ---
      allow read: if true; 
      // --- END TEMPORARY RULE ---
      allow write: if isOwner(userId);
    }

    /*
    // =====================================================================
    // SECURE RULE (Use this after debugging is complete)
    // =====================================================================
    match /users/{userId}/bookings/{bookingId} {
      allow read, write: if isOwner(userId);
    }
    */
  }
}
