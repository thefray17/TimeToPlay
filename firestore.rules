
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //-------------------------------------------------------------------------
    // Helper Functions
    //-------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    //-------------------------------------------------------------------------
    // Collection Rules
    //-------------------------------------------------------------------------

    // 1. Courts are public and read-only for clients.
    match /courts/{courtId} {
      allow read: if true;
      allow write: if false; // Managed by admin script

      // Availability is also public and read-only.
      match /availability/{dateKey} {
        allow read: if true;
        allow write: if false;
      }
    }

    // 2. Users can only read and write their own document and all subcollections.
    // This single rule covers /users/{userId}, /users/{userId}/bookings/{bookingId},
    // /users/{userId}/favorites/{courtId}, and any other future subcollections.
    match /users/{userId}/{path=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
