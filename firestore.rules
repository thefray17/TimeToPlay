rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // -----------------------
    // Courts (public read)
    // -----------------------
    match /courts/{courtId} {
      allow read: if true;

      // Create: allow if the NEW doc claims the requester as owner
      allow create: if signedIn() && request.resource.data.ownerId == uid();

      // Update/Delete: allow if EXISTING doc owner matches
      allow update, delete: if signedIn() && resource.data.ownerId == uid();

      match /availability/{dateKey} {
        allow read: if true;

        match /locks/{slotId} {
          allow read: if true;

          // Users can create a lock if it doesn't exist (ensure no overlap)
          allow create: if signedIn()
            && request.resource.data.userId == uid()
            && !exists(/databases/$(database)/documents/courts/$(courtId)/availability/$(dateKey)/locks/$(slotId));

          // Delete: allow lock owner OR court owner (owner needs to release on decline)
          allow delete: if signedIn()
            && (resource.data.userId == uid()
              || get(/databases/$(database)/documents/courts/$(courtId)).data.ownerId == uid());

          allow update: if false;
        }
      }
    }

    // -----------------------
    // Canonical Bookings (single source of truth)
    // -----------------------
    match /bookings/{bookingId} {
      // Player can read their own; Owner can read their own
      allow read: if signedIn()
        && (resource.data.userId == uid() || resource.data.ownerId == uid());

      // Create only if caller is the booking userId and court really belongs to ownerId
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && get(/databases/$(database)/documents/courts/$(request.resource.data.courtId)).data.ownerId
          == request.resource.data.ownerId;

      // Update: player or owner (status changes, etc.)
      allow update: if signedIn()
        && (resource.data.userId == uid() || resource.data.ownerId == uid());

      // Delete: disallow for now (avoid wiping history)
      allow delete: if false;
    }

    // -----------------------
    // Users (profile + favorites)
    // -----------------------
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;

      match /favorites/{favoriteId} {
        allow read, write, create, delete: if signedIn() && uid() == userId;
      }
    }
  }
}
